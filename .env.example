NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Clerk (from dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk routes (written by `clerk init`)
